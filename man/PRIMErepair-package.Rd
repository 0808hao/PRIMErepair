\alias{PRIMErepair}
\docType{package}
\title{Budgeted Certification of Minimum-Cost Prediction Alternatives}
\description{Finite-pool deterministic and statistical certification for locked binary probability predictions, with separate fixed-budget point estimation.}
\details{Start with \code{\link{prime_pool}} or \code{\link{prime_example}}, then \code{\link{prime_audit}}. Consult \code{\link{prime_methods}} for methods and \code{\link{prime_lure}} for non-certifying point estimates. Method details are installed in doc/METHODS.md.}
\references{
Waudby-Smith I and Ramdas A (2020). Confidence sequences for sampling without replacement. NeurIPS 33.
\href{https://proceedings.neurips.cc/paper/2020/hash/e96c7de8f6390b1e6c71556e4e0a4959-Abstract.html}{NeurIPS proceedings, 2020}

Hara S, Matsuura M, Honda J and Ito S (2024). Active model selection: A variance minimization approach. Machine Learning 113, 8327--8345. \doi{10.1007/s10994-024-06603-1}.

Kossen J, Farquhar S, Gal Y and Rainforth T (2021). Active Testing: Sample-Efficient Model Evaluation. PMLR 139, 5753--5763. \url{https://proceedings.mlr.press/v139/kossen21a.html}
}
